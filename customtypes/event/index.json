                },
                "media_image": {
                  "type": "Image",
                  "config": {
                    "label": "Image",
                    "constraint": {
                      "width": 2400,
                      "height": 2400
                    },
                    "thumbnails": []
                  }
                },
                "media_video_file": {
                  "type": "Link",
                  "config": {
                    "label": "Video file (mp4/webm)",
                    "select": "media",
                    "allowTargetBlank": false
                  }
                },
                "media_embed": {
                  "type": "Embed",
                  "config": {
                    "label": "Embed"
                  }
                },
                "poster": {
                  "type": "Image",
                  "config": {
                    "label": "Poster (optional)",
                    "constraint": {
                      "width": 2400,
                      "height": 2400
