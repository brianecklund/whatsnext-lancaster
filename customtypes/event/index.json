{
  "format": "custom",
  "id": "event",
  "label": "Event",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "summary": {
        "type": "Text",
        "config": {
          "label": "Summary",
          "placeholder": ""
        }
      },
      "start_datetime": {
        "type": "Timestamp",
        "config": {
          "label": "Start Date & Time",
          "placeholder": ""
        }
      },
      "end_datetime": {
        "type": "Timestamp",
        "config": {
          "label": "End Date & Time",
          "placeholder": ""
        }
      },
      "all_day": {
        "type": "Boolean",
        "config": {
          "label": "All Day",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "event_type": {
        "type": "Select",
        "config": {
          "label": "Event Type",
          "placeholder": "",
          "options": ["1", "2"]
        }
      },
      "status": {
        "type": "Select",
        "config": {
          "label": "Status",
          "placeholder": "",
          "options": ["1", "2"]
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "cost": {
        "type": "Text",
        "config": {
          "label": "Cost / Cover",
          "placeholder": ""
        }
      },
      "age_restriction": {
        "type": "Select",
        "config": {
          "label": "Age Restriction",
          "placeholder": "",
          "options": ["1", "2"]
        }
      },
      "website_url": {
        "type": "Link",
        "config": {
          "label": "Event Website URL",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "tickets_url": {
        "type": "Link",
        "config": {
          "label": "Tickets_url",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": true,
          "repeat": false
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Hero Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags",
          "repeat": true,
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag",
                "placeholder": ""
              }
            }
          }
        }
      },
      "location": {
        "type": "Link",
        "config": {
          "label": "Location",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "location",
              "fields": [
                "name",
                "description",
                "address",
                "website",
                "category"
              ]
            }
          ]
        }
      }
    }
  }
}
