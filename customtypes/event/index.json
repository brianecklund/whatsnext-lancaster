              "fieldset": "Showcase Hero",
              "description": "Large hero media (image/video/embed)",
              "icon": "image",
              "display": "list",
              "non-repeat": {
                "style": {
                  "type": "Select",
                  "config": {
                    "label": "Style",
                    "options": [
                      "clean",
                      "poster",
                      "glow"
                    ]
