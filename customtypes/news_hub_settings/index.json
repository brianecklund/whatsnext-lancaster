            },
            "tile_2_image": {
              "type": "Image",
              "config": {
                "label": "Tile 2 image",
                "constraint": {},
                "thumbnails": []
              }
            },
            "tile_2_link": {
              "type": "Link",
              "config": {
                "label": "Tile 2 link",
                "placeholder": "",
                "select": null,
                "allowTargetBlank": true,
                "allowText": false,
                "repeat": false
              }
